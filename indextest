// B · CONDONGAN (gyroscope / tetikus)
// ══════════════════════════════════════════════════
let tx=0, ty=0, cx=0, cy=0, gyroLive=false, base=null;
const clamp = v => Math.max(-1, Math.min(1, v));
const setTarget = (x,y) => { tx = clamp(x); ty = clamp(y); };

addEventListener('mousemove', e => {
  if (gyroLive) return;
  setTarget((e.clientX/innerWidth-.5)*2, (e.clientY/innerHeight-.5)*2);
});
function onOrient(e){
  if (e.gamma === null && e.beta === null) return;
  gyroLive = true;
  const g = e.gamma||0, b = e.beta||0;
  const ang = screen.orientation ? screen.orientation.angle : (window.orientation||0);
  let x,y;
  if (Math.abs(ang) === 90){ x = b; y = (ang === 90 ? -g : g); }
  else { x = g; y = b; }
  if (!base) base = {x,y};
  setTarget((x-base.x)/35, (y-base.y)/35);
}
addEventListener('orientationchange', () => { base = null; });

