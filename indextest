// D · GRID PERSPEKTIF
// ══════════════════════════════════════════════════
const cv = $('grid'), g2 = cv.getContext('2d');
let W,H,DPR;
function resize(){
  DPR = Math.min(devicePixelRatio||1, 2);
  W = innerWidth; H = innerHeight;
  cv.width = W*DPR; cv.height = H*DPR;
  cv.style.width = W+'px'; cv.style.height = H+'px';
  g2.setTransform(DPR,0,0,DPR,0,0);
}
addEventListener('resize', resize); resize();

function gridRGB(){
  const cs = getComputedStyle(document.documentElement);
  return [cs.getPropertyValue('--grid-r').trim()||217,
          cs.getPropertyValue('--grid-g').trim()||180,
          cs.getPropertyValue('--grid-b').trim()||92];
}
let GC = gridRGB();
function drawGrid(t){
  g2.clearRect(0,0,W,H);
  const [r,g,b] = GC;
  const horizon = H*0.58 + cy*14, vpx = W/2 - cx*70;
  g2.lineWidth = 1;
  for(let i=1;i<=16;i++){
    const k=i/16, y = horizon + Math.pow(k,2.3)*(H-horizon)*1.7;
    if(y>H) break;
    g2.strokeStyle = `rgba(${r},${g},${b},${(.3*(1-k)+.04).toFixed(3)})`;
    g2.beginPath(); g2.moveTo(0,y); g2.lineTo(W,y); g2.stroke();
  }
  g2.strokeStyle = `rgba(${r},${g},${b},0.10)`;
  for(let i=-12;i<=12;i++){
    g2.beginPath(); g2.moveTo(vpx+i*11, horizon); g2.lineTo(vpx+i*W*0.2, H+40); g2.stroke();
  }
  const pulse = (t*0.00016)%1;
  const py = horizon + Math.pow(pulse,2.3)*(H-horizon)*1.7;
  g2.strokeStyle = `rgba(247,226,168,${(.45*(1-pulse)).toFixed(3)})`;
  g2.beginPath(); g2.moveTo(0,py); g2.lineTo(W,py); g2.stroke();
}

