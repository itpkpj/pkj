// C · SENSOR GONCANG
// ══════════════════════════════════════════════════
let watching=false, lastMag=0, lastHit=0, hits=0, motionOn=false;
function onMotion(e){
  const a = e.accelerationIncludingGravity;
  if (!a || a.x === null) return;
  motionOn = true;
  const mag = Math.hypot(a.x||0, a.y||0, a.z||0);
  const delta = Math.abs(mag - lastMag);
  lastMag = mag;
  if (!watching) return;
  const now = Date.now();
  if (delta > 13 && now - lastHit > 120){
    lastHit = now;
    if (++hits >= 3){ hits = 0; doSearch('goncang'); }
  }
  if (now - lastHit > 900) hits = 0;
}
const startShakeWatch = () => { watching = true; hits = 0; };
const stopShakeWatch  = () => { watching = false; };

const needsPerm = typeof DeviceMotionEvent !== 'undefined' &&
                  typeof DeviceMotionEvent.requestPermission === 'function';
const motionBtn = $('enableMotion');

function attachSensors(){
  addEventListener('deviceorientation', onOrient, true);
  addEventListener('deviceorientationabsolute', onOrient, true);
  addEventListener('devicemotion', onMotion);
}
if (needsPerm){
  motionBtn.hidden = false;
  motionBtn.addEventListener('click', async () => {
    try{
      const a = await DeviceMotionEvent.requestPermission();
      if (typeof DeviceOrientationEvent.requestPermission === 'function')
        await DeviceOrientationEvent.requestPermission();
      if (a === 'granted'){ attachSensors(); motionBtn.hidden = true; }
      else motionBtn.textContent = 'Akses ditolak — guna butang Semak';
    }catch(e){ motionBtn.textContent = 'Sensor perlu HTTPS — guna butang Semak'; }
  });
} else if (typeof DeviceMotionEvent !== 'undefined'){
  attachSensors();
}
// Jika tiada sensor (desktop) — tukar teks kepada arahan tekan butang
setTimeout(() => {
  if (!motionOn && !needsPerm) fallbackToTap();
}, 1500);
function fallbackToTap(){
  const t = i18n[lang];
  const a = $('askShake');
  a.querySelector('.shakeMsg').textContent = t.tapMsg;
  a.querySelector('.shakeSub').textContent = t.tapSub;
  const ph = a.querySelector('.phone'); if (ph) ph.style.display = 'none';
  $('motionNote').style.display = 'none';
}

