// F · LOADER MENARA 12 TINGKAT
// ══════════════════════════════════════════════════
const FLOORS = 12, tower = $('tower'), roof = $('roof');
for (let i=0;i<FLOORS;i++){ const f=document.createElement('div'); f.className='floor'; tower.appendChild(f); }
const floors = [...tower.children];
const STAGE_AT = [0,22,48,72,92];

let _dataReady = false;   // ditetapkan bila JSONP selesai
function runLoader(done){
  const t = i18n[lang];
  $('loader').classList.add('show');
  document.body.classList.add('busy');
  floors.forEach(f => f.classList.remove('built'));
  roof.classList.remove('built');
  const t0 = performance.now();
  // Jika data sudah sedia (pra-ambil / cache), pendekkan animasi — jangan
  // paksa pengguna tunggu tanpa sebab.
  const DURATION = reduce ? 250 : (_dataReady ? 1000 : 2200);
  (function step(now){
    const k = Math.min((now-t0)/DURATION, 1);
    let p = Math.round((1 - Math.pow(1-k,2.2)) * 100);
    // Tahan pada 92% sehingga data tiba (elak "siap" sebelum pelayan jawab)
    if (!_dataReady) p = Math.min(p, 92);
    $('pct').textContent = p + '%';
    const built = Math.floor(p/100 * FLOORS);
    floors.forEach((f,i) => {
      if (i < built && !f.classList.contains('built')){ f.classList.add('built'); buzz(8); }
    });
    if (p >= 99) roof.classList.add('built');
    for (let i = STAGE_AT.length-1; i >= 0; i--)
      if (p >= STAGE_AT[i]){ $('stageTxt').textContent = t.stages[i]; break; }
    if (k < 1 || !_dataReady) requestAnimationFrame(step);
    else setTimeout(() => {
      $('loader').classList.remove('show');
      document.body.classList.remove('busy');
      done();
    }, 400);
  })(t0);
}

