// E · GELUNG RENDER
// ══════════════════════════════════════════════════
const rig = $('rig'), aura = $('aura'), cardEl = $('card');
let raf;
function frame(t){
  cx += (tx-cx)*0.055;
  cy += (ty-cy)*0.055;
  rig.style.transform = `rotateX(${(-cy*16).toFixed(2)}deg) rotateY(${(cx*22).toFixed(2)}deg) translateZ(${(-Math.abs(cx)*10).toFixed(1)}px)`;
  aura.style.transform = `translate(calc(-50% + ${(-cx*26).toFixed(1)}px), calc(-50% + ${(-cy*16).toFixed(1)}px))`;
  cardEl.style.transform = `translate(${(cx*6).toFixed(1)}px, ${(cy*4).toFixed(1)}px)`;
  drawGrid(t);
  raf = requestAnimationFrame(frame);
}
if (reduce) drawGrid(0); else raf = requestAnimationFrame(frame);
document.addEventListener('visibilitychange', () => {
  if (document.hidden) cancelAnimationFrame(raf);
  else if (!reduce) raf = requestAnimationFrame(frame);
});

