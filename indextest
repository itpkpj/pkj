const ic = $('icInput'), cnt = $('cnt'), errEl = $('err'), box = $('shakeBox'), searchBtn = $('searchBtn');
let ready = false, busy = false;

function digits(){ return ic.value.replace(/\D/g,''); }
function updateCount(){ cnt.textContent = i18n[lang].countTxt.replace('{n}', digits().length); }

ic.addEventListener('focus', () => document.body.classList.add('focused'));
ic.addEventListener('blur',  () => document.body.classList.remove('focused'));
ic.addEventListener('keydown', e => { if(e.key==='Enter' && ready) doSearch('butang'); });

ic.addEventListener('input', () => {
  const d = ic.value.replace(/\D/g,'').slice(0,12);
  let out = d;
  if (d.length > 6) out = d.slice(0,6) + '-' + d.slice(6);
  if (d.length > 8) out = d.slice(0,6) + '-' + d.slice(6,8) + '-' + d.slice(8);
  ic.value = out;
  updateCount();
  errEl.textContent = '';

  const full = d.length === 12;
  if (full === ready) return;
  ready = full;
  ic.classList.toggle('done', full);
  box.classList.toggle('show', full);
  searchBtn.disabled = !full;
  document.body.classList.toggle('armed', full);
  if (full){
    buzz(20);
    setTimeout(() => ic.blur(), 180);   // tutup papan kekunci
    startShakeWatch();
    startPrefetch(ic.value.trim());     // ⚡ mula ambil data sekarang juga
  } else { stopShakeWatch(); cancelPrefetch(); }
});

$('reset').addEventListener('click', resetAll);
function resetAll(){
  buzz(15);
  ic.value = ''; updateCount(); errEl.textContent = '';
  ic.classList.remove('done');
  ready = false; busy = false; _lastResult = null;
  box.classList.remove('show');
  const r = $('result'); r.classList.remove('show'); r.style.display='none'; r.innerHTML='';
  $('askShake').hidden = false;
  $('newCheck').hidden = true;
  if (motionOn || needsPerm) $('motionNote').style.display = '';
  searchBtn.disabled = true;
  document.body.classList.remove('armed');
  stopShakeWatch();
  window.scrollTo({top:0,behavior:'smooth'});
  setTimeout(()=>ic.focus(), 350);
}

