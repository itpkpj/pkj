let _jsonpSeq = 0;
function jsonp(url, cb, timeoutMs) {
  const name = 'cb_' + Date.now() + '_' + (++_jsonpSeq);
  const s = document.createElement('script');
  let done = false, timer = null;
  const finish = (err, d) => {
    if (done) return;
    done = true;
    if (timer) clearTimeout(timer);
    try { delete window[name]; } catch(e) { window[name] = undefined; }
    if (s.parentNode) s.parentNode.removeChild(s);
    cb(err, d);
  };
  window[name] = d => finish(null, d);
  s.onerror   = () => finish(new Error('network'));
  timer = setTimeout(() => finish(new Error('timeout')), timeoutMs || 7000);
  s.src = url + '&callback=' + name + '&_=' + Date.now();
  document.body.appendChild(s);
}

// ══════════════════════════════════════════════════
// I2 · PEMANASAN + PRA-AMBIL (prefetch) + CACHE
// ══════════════════════════════════════════════════
// Apps Script "cold start" boleh makan 3-6 saat pada hit pertama.
// Kita panggang bekas itu sebaik halaman dibuka, secara senyap.
let _warmed = false;
function warmUp(){
  if (_warmed) return; _warmed = true;
  jsonp(`${APPS_SCRIPT_URL}?action=search&ic=000000000000`, () => {}, 12000);
}
if (document.readyState === 'loading')
  document.addEventListener('DOMContentLoaded', () => setTimeout(warmUp, 250));
else setTimeout(warmUp, 250);

// Cache keputusan mengikut IC — tekan Semak semula = 0 saat
const _cache = new Map();
// Pra-ambil: hantar permintaan sebaik digit ke-12 ditaip, sebelum pengguna
// sempat goncang / tekan butang. Data selalunya sudah tiba dulu.
let _pf = null;   // { key, status:'wait'|'done', data, err, cbs:[] }

function startPrefetch(icVal){
  const key = icVal.replace(/\D/g,'');
  if (_pf && _pf.key === key) return;
  if (_cache.has(key)) { _pf = { key, status:'done', data:_cache.get(key), err:null, cbs:[] }; return; }
  const rec = { key, status:'wait', data:null, err:null, cbs:[] };
  _pf = rec;
  const url = `${APPS_SCRIPT_URL}?action=search&ic=${encodeURIComponent(icVal)}`;
  let attempt = 0;
  (function go(){
    attempt++;
    jsonp(url, (err, data) => {
      if ((err || !data) && attempt < 2) { setTimeout(go, 300); return; }
      if (_pf !== rec) return;              // IC sudah berubah — buang
      rec.status = 'done'; rec.data = data; rec.err = err;
      if (data && data.success !== undefined) _cache.set(key, data);
      rec.cbs.splice(0).forEach(cb => cb(err, data));
    }, 15000);
  })();
}
function cancelPrefetch(){ _pf = null; }

// Ambil hasil: guna cache → prefetch yang sedang jalan → permintaan baharu
function fetchResult(icVal, cb){
  const key = icVal.replace(/\D/g,'');
  if (_cache.has(key)) { cb(null, _cache.get(key)); return; }
  if (_pf && _pf.key === key){
    if (_pf.status === 'done') cb(_pf.err, _pf.data);
    else _pf.cbs.push(cb);
    return;
  }
  startPrefetch(icVal);
  _pf.cbs.push(cb);
}

// ══════════════════════════════════════════════════
// J · SEMAKAN (loader + data serentak)
// ══════════════════════════════════════════════════
function doSearch(via) {
  const val = ic.value.trim();
  const t   = i18n[lang];
  if (busy) return;
  if (digits().length !== 12) { errEl.textContent = t.errEmpty; return; }

  busy = true; stopShakeWatch(); buzz(30);
  _dataReady = false;
  let payload = null, payloadErr = null;

  // 1) Mula loader (ia akan tahan pada 92% sehingga data tiba)
  runLoader(() => {
    busy = false;
    _lastResult = payload;
    if (payloadErr || !payload) showError(t.errServer);
    else if (payload.success) showSuccess(payload);
    else showError(payload.message || t.foundErr);
    finishUI();
  });

  // 2) Data — selalunya sudah siap dari pra-ambil, jadi serta-merta
  fetchResult(val, (err, data) => {
    payload = data; payloadErr = err;
    _dataReady = true;
  });
}

function finishUI(){
  buzz([30,60,30]);
  $('askShake').hidden = true;
  $('newCheck').hidden = false;
  $('motionNote').style.display = 'none';
  searchBtn.disabled = true;
  document.body.classList.remove('armed');
  const r = $('result');
  requestAnimationFrame(() => r.scrollIntoView({behavior:'smooth', block:'nearest'}));
}

// ══════════════════════════════════════════════════
// K · PAPAR KEPUTUSAN (susunan kekal seperti asal)
// ══════════════════════════════════════════════════
function showSuccess(d) {
  const t   = i18n[lang];
  const el  = $('result');
  const allHadir   = d.allHadir;
  const totalCount = d.matches.length;
  const sheetList  = d.sheets || [d.matches[0].sheet];

  if (sheetList.length === 1) el.setAttribute('data-sheet', sheetList[0]);
  else el.removeAttribute('data-sheet');

  const sheetBadgesHTML = sheetList.map(s => `<span class="sheet-badge ${s}">📋 ${s}</span>`).join('');
  const sheetTagsHTML   = sheetList.map(s => `<span class="rs-sheet-tag ${s}">${s}</span>`).join('');
  const summaryHTML = `
    <div class="result-summary">
      <span class="rs-count">${esc(t.multiLabel.replace('{n}', String(totalCount)))}</span>
      <span class="rs-sheets">${sheetTagsHTML}</span>
    </div>`;

  const groups = d.sheetGroups || (() => {
    const g = {};
    for (const m of d.matches) { if (!g[m.sheet]) g[m.sheet] = []; g[m.sheet].push(m); }
    return g;
  })();

  const groupsHTML = Object.entries(groups).map(([sheetName, matches]) => {
    const matchCards = matches.map(m => {
      const cardId = ('mc_' + m.sheet + '_' + m.row).replace(/[^a-zA-Z0-9_]/g, '_');

      let sesiHTML = '';
      if (m.sesi !== undefined && m.sesi !== null && String(m.sesi).trim() !== '') {
        const sv = String(m.sesi).trim().toLowerCase();
        const sCls = (sv === '2' || sv.indexOf('petang') > -1) ? 'petang'
                   : (sv === '1' || sv.indexOf('pagi')   > -1) ? 'pagi' : '';
        const sTxt = sCls === 'petang' ? t.sesiPetang : (sCls === 'pagi' ? t.sesiPagi : esc(m.sesi));
        const sTime = sCls === 'pagi' ? '9.00-11.00 pagi' : (sCls === 'petang' ? '2.00 petang' : '');
        if (sCls) sesiHTML = `<span class="mc-sesi ${sCls}">🕒 ${esc(t.sesiLbl)}: ${esc(sTxt)}${sTime ? ' · ' + esc(sTime) : ''}</span>`;
      }

      let footerHTML;
      if (_terimaMode) {
        if (m.sudahTerima) {
          footerHTML = `<div class="mc-terima-strip received"><span class="mc-terima-dot"></span><span>${esc(t.statusTerima)}</span></div>`;
        } else if (m.sudahHadir) {
          footerHTML = `<div class="mc-terima-action">
            <button class="btn-terima-card"
              onclick="openTerimaConfirm('${esc(m.sheet)}',${Number(m.row)||0},'${esc(m.ic)}','${esc(m.kaunter||'')}','${cardId}')">
              ${esc(t.btnTerimaCard)}
            </button>
          </div>`;
        } else {
          footerHTML = `<div class="mc-terima-locked">🔒 ${esc(t.terimaLocked)}</div>`;
        }
      } else {
        footerHTML = `<div class="mc-terima-strip ${m.sudahTerima ? 'received' : 'pending'}">
          <span class="mc-terima-dot"></span>
          ${m.sudahTerima ? `<span>${esc(t.statusTerima)}</span>` : `<span>${esc(t.statusBelumTerima)}</span>`}
        </div>`;
      }

      return `
      <div class="match-card" id="${cardId}">
        <div class="mc-main">
          <div class="mc-kaunter">
            <div class="mc-k-lbl">${esc(t.keyKaunter)}</div>
            <div class="mc-k-num">${esc(m.kaunter||'—')}</div>
          </div>
          <div class="mc-divider"></div>
          <div class="mc-info">
            <div class="mc-info-row"><span class="mk">${esc(t.keyNoSiri)}</span><span class="mv">${esc(m.siri||'—')}</span></div>
            <div class="mc-info-row"><span class="mk">${esc(t.keyBantuan)}</span><span class="mv">${esc(m.bantuan||'—')}</span></div>
            ${sesiHTML}
          </div>
          <div class="mc-status">
            ${m.sudahHadir
              ? `<div class="mc-hadir" title="${esc(t.statusHadir)}">✅</div>`
              : `<div class="mc-tidak" title="${esc(t.statusTidak)}">⏳</div>`}
          </div>
        </div>
        ${footerHTML}
      </div>`;
    }).join('');

    return `
      <div class="sheet-group ${sheetName}">
        <div class="sheet-group-header">
          <span>📋 ${sheetName}</span>
          <span style="opacity:.7;font-weight:500">${matches.length} ${esc(t.keyKaunter)}</span>
        </div>
        <div class="sheet-group-body">${matchCards}</div>
      </div>`;
  }).join('');

  let kehHTML = '';
  if (allHadir) {
    kehHTML = `<div class="sudah-hadir">${esc(t.sudahHadir)}</div>`;
  } else {
    const entries = JSON.stringify(d.matches.map(m => ({sheet: m.sheet, row: m.row})));
    kehHTML = `
      <div class="keh-q">${esc(t.kehQ)}</div>
      <div class="keh-btns" id="kehBtns">
        <button class="btn-ya" id="btnYa" onclick="rekodMulti(this)"
          data-entries='${entries.replace(/'/g,"&#39;")}'>${esc(t.btnYa)}</button>
        <button class="btn-tidak" onclick="batalKeh()">${esc(t.btnTidak)}</button>
      </div>
      <div class="keh-msg" id="kehMsg" style="display:none;"></div>`;
  }

  el.innerHTML = `
    <div class="res-header">
      ${_terimaMode ? `<div style="display:flex;gap:6px;flex-wrap:wrap;">${sheetBadgesHTML}</div>` : '<span></span>'}
      <span class="found-tag ok">✓ ${esc(t.foundOk)}</span>
    </div>
    <div class="res-nama">${esc(d.nama)}</div>
    <div class="res-ic">${esc(d.ic)}</div>
    ${_terimaMode ? (totalCount > 1 ? summaryHTML : '') : ''}
    ${_terimaMode ? groupsHTML : ''}
    <div class="keh-section">
      <div class="keh-title">${esc(t.kehTitle)}</div>
      ${kehHTML}
    </div>
    ${_terimaMode ? '' : `<div class="kaunter-notice">
        <div class="kn-icon">🔒</div>
        <div class="kn-text">
          <div class="kn-title">${esc(t.knTitle)}</div>
          <div class="kn-sub">${esc(t.knSub)}</div>
        </div>
      </div>`}`;

  el.style.display = 'block';
  el.classList.add('show');

  if (_terimaMode) recordKehadiranSemasa(d.matches);
}

function showError(msg) {
  const t  = i18n[lang];
  const el = $('result');
  el.innerHTML = `
    <div class="res-header"><span class="found-tag err">✕ ${esc(t.foundErr)}</span></div>
    <div class="err-box">${esc(msg)}</div>`;
  el.style.display = 'block';
  el.classList.add('show');
  el.removeAttribute('data-sheet');
}

// ── REKOD KEHADIRAN (Column F) ──
function rekodMulti(btn) {
  const t = i18n[lang];
  const entries = btn ? btn.getAttribute('data-entries') : '[]';
  const btns  = $('kehBtns');
  if (btn) btn.disabled = true;
  jsonp(`${APPS_SCRIPT_URL}?action=rekodmulti&entries=${encodeURIComponent(entries)}`, (err, data) => {
    const msg = $('kehMsg');
    if (err || !data) {
      if (msg) { msg.className='keh-msg err'; msg.textContent=t.recodErr; msg.style.display='block'; }
      if (btn) btn.disabled = false;
      return;
    }
    if (msg) {
      msg.className = data.success ? 'keh-msg ok' : 'keh-msg err';
      msg.textContent = data.success ? t.recodOk : (data.message || t.recodErr);
      msg.style.display = 'block';
    }
    if (data.success && btns) btns.innerHTML = `<div class="sudah-hadir">${esc(t.sudahHadir)}</div>`;
  });
}
function batalKeh() {
  const s = document.querySelector('.keh-section');
  if (s) s.style.display = 'none';
}
function esc(s) {
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

applyI18n(); updateCount();

// ══════════════════════════════════════════════════
// L · MOD TERIMA (?terima=1)
// ══════════════════════════════════════════════════
const _urlParams  = new URLSearchParams(window.location.search);
const _terimaMode = _urlParams.get('terima') === '1';

if (_terimaMode) {
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', showTerimaBanner);
  else setTimeout(showTerimaBanner, 100);
}

function showTerimaBanner() {
  const t = i18n[lang];
  const shell = $('shell'), card = $('card');
  if (!card) return;
  const existing = $('terimaBanner');
  if (existing) existing.remove();
  const banner = document.createElement('div');
  banner.className = 'terima-banner';
  banner.id = 'terimaBanner';
  banner.innerHTML =
    '<div class="terima-banner-icon">🎁</div>' +
    '<div class="terima-banner-text">' +
      '<div class="terima-banner-title">' + esc(t.terimaModeTitle) + '</div>' +
      '<div class="terima-banner-sub">' + esc(t.terimaModeSub) + '</div>' +
    '</div>';
  shell.insertBefore(banner, card);
  ic.focus();
}

let _terimaTarget = null;
function openTerimaConfirm(sheet, row, icNo, kaunter, cardId) {
  const t = i18n[lang];
  _terimaTarget = { sheet, row: parseInt(row, 10), ic: icNo, cardId };
  $('terimaQTitle').textContent = t.terimaQTitle;
  $('terimaQSub').innerHTML     = t.terimaQSub.replace('{k}', esc(kaunter || '—'));
  $('terimaQYa').textContent    = t.terimaYa;
  $('terimaQTidak').textContent = t.terimaTidak;
  $('terimaQYa').disabled = false;
  $('terimaQResult').style.display = 'none';
  $('terimaQBtns').style.display   = 'flex';
  $('terimaConfirmModal').style.display = 'flex';
}
function closeTerimaConfirm() {
  $('terimaConfirmModal').style.display = 'none';
  _terimaTarget = null;
}
function submitTerimaConfirm() {
  if (!_terimaTarget) return;
  const t = i18n[lang];
  const yaBtn = $('terimaQYa');
  yaBtn.disabled = true; yaBtn.textContent = '⏳';
  const { sheet, row, ic: icNo, cardId } = _terimaTarget;
  jsonp(`${APPS_SCRIPT_URL}?action=rekodterimaIC&sheet=${encodeURIComponent(sheet)}&row=${row}&ic=${encodeURIComponent(icNo)}`,
    (err, res) => {
      const resultEl = $('terimaQResult');
      resultEl.style.display = 'block';
      if (err || !res || (!res.success && !res.alreadyDone)) {
        resultEl.className   = 'confirm-result err';
        resultEl.textContent = (res && res.message) ? res.message : t.terimaErr;
        yaBtn.disabled = false; yaBtn.textContent = t.terimaYa;
        return;
      }
      resultEl.className   = 'confirm-result ok';
      resultEl.textContent = t.terimaDone;
      $('terimaQBtns').style.display = 'none';
      markCardReceived(cardId);
      if (_lastResult && _lastResult.matches) {
        const rec = _lastResult.matches.find(m => m.sheet === sheet && parseInt(m.row,10) === row);
        if (rec) { rec.terima = 'Ya'; rec.sudahTerima = true; }
      }
      setTimeout(closeTerimaConfirm, 1500);
    });
}
function markCardReceived(cardId) {
  const t = i18n[lang];
  const c = $(cardId);
  if (!c) return;
  const footer = c.querySelector('.mc-terima-action, .mc-terima-locked, .mc-terima-strip');
  if (footer) {
    footer.className = 'mc-terima-strip received';
    footer.innerHTML = '<span class="mc-terima-dot"></span><span>' + esc(t.statusTerima) + '</span>';
  }
}

// ── KEHADIRAN SEMASA (Column H) ──
function recordKehadiranSemasa(matches) {
  if (!matches || !matches.length) return;
  const pending = matches.filter(m => !m.sudahHadir2);
  if (!pending.length) { showKehadiranSemasaBanner(); return; }
  const entries = pending.map(m => ({ sheet: m.sheet, row: m.row }));
  jsonp(`${APPS_SCRIPT_URL}?action=rekodhadir2&entries=${encodeURIComponent(JSON.stringify(entries))}`,
    (err, res) => {
      if (res && res.success) {
        matches.forEach(m => { m.hadir2 = 'Ya'; m.sudahHadir2 = true; });
        if (_lastResult && _lastResult.matches) _lastResult.matches.forEach(m => { m.hadir2='Ya'; m.sudahHadir2=true; });
        showKehadiranSemasaBanner();
      }
    });
}
function showKehadiranSemasaBanner() {
  const b = $('terimaBanner');
  if (!b) return;
  const sub = b.querySelector('.terima-banner-sub');
  if (sub) sub.innerHTML = '✓ ' + esc(i18n[lang].hadirSemasaDone);
}

