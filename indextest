<!DOCTYPE html>
<html lang="ms" data-theme="dark" data-lang="ms">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0,viewport-fit=cover"/>
<title>Semak Nombor Kaunter — PKPJ</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700;800&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet"/>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
:root{
  --mono:'DM Mono',monospace;
  --radius:18px; --radius-sm:12px;
  --ease:.28s cubic-bezier(.4,0,.2,1);

  /* ══ TEMA EMAS (aura gold) ══ */
  --gold:#d9b45c; --gold-hi:#f7e2a8; --gold-lo:#8c6b28;

  /* Warna kumpulan sheet — kekal berbeza untuk pengecaman pantas */
  --bsr-h:#5b9dff; --bsr-d:rgba(91,157,255,.16); --bsr-b:rgba(91,157,255,.38);
  --bmr-h:#c084fc; --bmr-d:rgba(192,132,252,.16); --bmr-b:rgba(192,132,252,.38);
  --bbr-h:#34d399; --bbr-d:rgba(52,211,153,.16); --bbr-b:rgba(52,211,153,.38);
  --green:#5ce8a4; --red:#ff7a7a; --yellow:#f59e0b;
  --sheet-h:var(--gold); --sheet-d:rgba(217,180,92,.16); --sheet-b:rgba(217,180,92,.38);
}
[data-theme="dark"]{
  --bg:#070b14; --bg2:#0e1526;
  --card:rgba(20,29,50,.86); --card2:rgba(10,16,30,.9);
  --surface:rgba(7,11,20,.62);
  --border:rgba(217,180,92,.28); --border2:rgba(217,180,92,.45);
  --text:#f2f6ff; --text2:#b9c6dd; --text3:#8ea3c4;
  --shadow:rgba(0,0,0,.7);
  --grid-r:217; --grid-g:180; --grid-b:92; --grid-op:1;
  --vig:rgba(7,11,20,.88);
}
[data-theme="light"]{
  --bg:#fbf7ee; --bg2:#f3ead6;
  --card:rgba(255,253,248,.92); --card2:rgba(252,247,236,.95);
  --surface:rgba(255,255,255,.75);
  --border:rgba(140,107,40,.3); --border2:rgba(140,107,40,.5);
  --text:#251d0c; --text2:#5c4a25; --text3:#8a7440;
  --shadow:rgba(120,95,40,.16);
  --grid-r:160; --grid-g:120; --grid-b:40; --grid-op:.75;
  --vig:rgba(251,247,238,.9);
}
/* Tema cerah — emas lebih gelap supaya kontras cukup di atas latar krim */
[data-theme="light"]{
  --gold:#9a7420; --gold-hi:#5f4610; --gold-lo:#c9a04a;
}
/* Sheet active color switching */
[data-sheet="BSR"]{--sheet-h:var(--bsr-h);--sheet-d:var(--bsr-d);--sheet-b:var(--bsr-b);}
[data-sheet="BMR"]{--sheet-h:var(--bmr-h);--sheet-d:var(--bmr-d);--sheet-b:var(--bmr-b);}
[data-sheet="BBR"]{--sheet-h:var(--bbr-h);--sheet-d:var(--bbr-d);--sheet-b:var(--bbr-b);}

html,body{min-height:100%;}
body{
  background:var(--bg); color:var(--text);
  font-family:'DM Sans',sans-serif;
  -webkit-font-smoothing:antialiased; -webkit-tap-highlight-color:transparent;
  transition:background var(--ease),color var(--ease);
}

/* ══ LAPISAN 0 · latar grid + aura ══ */
#grid{position:fixed;inset:0;z-index:0;opacity:.55;}
#aura{
  position:fixed;left:50%;top:38%;width:min(130vw,880px);aspect-ratio:1;z-index:0;
  transform:translate(-50%,-50%);pointer-events:none;filter:blur(6px);
  background:radial-gradient(circle,rgba(217,180,92,.16),rgba(217,180,92,.04) 42%,transparent 68%);
  transition:opacity .6s;
}
body.armed #aura{opacity:1.5}
body.busy  #aura{opacity:2.2}

/* ══ LAPISAN 1 · LOGO 3D ══ */
#stage{
  position:fixed;inset:0;z-index:1;display:flex;justify-content:center;align-items:flex-start;
  padding-top:calc(9vh + env(safe-area-inset-top));
  perspective:900px;pointer-events:none;
}
#rig{
  position:relative;
  /* Lebar DAN tinggi ditetapkan secara eksplisit. aspect-ratio sahaja tidak
     cukup — pelayar lama (Safari <15, Chrome <88, Samsung Internet lama)
     abaikan ia, tinggi jadi 0, dan logo langsung tidak muncul. */
  width:150px; height:150px;
  width:min(38vw,160px); height:min(38vw,160px);
  aspect-ratio:1;
  transform-style:preserve-3d;will-change:transform;
}
.layer{position:absolute;inset:0;transform-style:preserve-3d;}
.slice{position:absolute;inset:0;background:url("./pkpj.png") center/contain no-repeat;}
.slice.back{filter:brightness(.22) saturate(.5)}
[data-theme="light"] .slice.back{filter:brightness(.55) saturate(.6)}
.slice.face{filter:drop-shadow(0 0 18px rgba(217,180,92,.45)) drop-shadow(0 0 60px rgba(217,180,92,.2))}
.sheen{
  position:absolute;inset:0;
  -webkit-mask:url("./pkpj.png") center/contain no-repeat;
          mask:url("./pkpj.png") center/contain no-repeat;
  background:linear-gradient(105deg,transparent 38%,rgba(255,255,255,.85) 50%,transparent 62%);
  background-size:280% 100%;mix-blend-mode:screen;opacity:.55;
  animation:sweep 5.5s cubic-bezier(.6,0,.35,1) infinite;
}
@keyframes sweep{0%,62%{background-position:180% 0}100%{background-position:-80% 0}}
.reflect{
  position:absolute;left:0;right:0;top:100%;height:100%;
  background:url("./pkpj.png") center top/contain no-repeat;transform:scaleY(-1);
  -webkit-mask:linear-gradient(to top,transparent 0,rgba(0,0,0,.5) 55%);
          mask:linear-gradient(to top,transparent 0,rgba(0,0,0,.5) 55%);
  opacity:.26;filter:blur(1px);
}
.handles{position:absolute;inset:-9px;border:1px solid var(--border2);border-radius:4px;opacity:.85;transition:opacity .5s;}

/* Sheen & reflect bergantung pada CSS mask. Jika pelayar tak menyokongnya,
   sorokkan — kalau tidak ia jadi kotak segi empat menutupi logo. */
@supports not ((-webkit-mask-image:linear-gradient(#000,#000)) or (mask-image:linear-gradient(#000,#000))){
  .sheen,.reflect{display:none !important;}
}
/* Fallback bila pkpj.png gagal dimuatkan */
body.nologo .slice,body.nologo .sheen,body.nologo .reflect{display:none;}
body.nologo #rig::after{
  content:"PKPJ";position:absolute;inset:0;display:grid;place-items:center;
  font-size:30px;font-weight:800;letter-spacing:.08em;
  background:linear-gradient(100deg,var(--gold-lo),var(--gold-hi) 45%,var(--gold));
  -webkit-background-clip:text;background-clip:text;color:transparent;
}
.handles i{position:absolute;width:7px;height:7px;background:var(--bg);border:1.5px solid var(--gold);border-radius:2px;}
.handles i:nth-child(1){left:-4px;top:-4px} .handles i:nth-child(2){right:-4px;top:-4px}
.handles i:nth-child(3){left:-4px;bottom:-4px} .handles i:nth-child(4){right:-4px;bottom:-4px}
body.focused .handles{opacity:0}

.panel{
  position:absolute;padding:11px 13px;border-radius:14px;white-space:nowrap;
  background:var(--card);border:1px solid var(--border);
  backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
  box-shadow:0 18px 50px var(--shadow),inset 0 1px 0 rgba(255,255,255,.06);
  animation:float 7s ease-in-out infinite;transition:opacity .55s cubic-bezier(.4,0,.2,1);
}
@keyframes float{0%,100%{translate:0 0}50%{translate:0 -9px}}
.panel .k{display:block;font-size:8px;letter-spacing:.16em;text-transform:uppercase;color:var(--gold);}
.panel .v{display:block;font-size:13.5px;font-weight:700;margin-top:2px;letter-spacing:-.01em;
  white-space:nowrap;font-variant-numeric:tabular-nums;color:var(--gold);}
body.focused .panel{opacity:.18}

/* Panel kekal ada pada telefon — dikecilkan & dirapatkan supaya tak terkeluar skrin */
@media (max-width:560px){
  .panel{
    padding:8px 10px;border-radius:11px;
    white-space:normal;max-width:38vw;
    animation-duration:8s;
  }
  .panel .k{font-size:7px;letter-spacing:.12em;line-height:1.3;}
  .panel .v{font-size:11.5px;margin-top:2px;}
  .panel[data-z="120"]{left:-46% !important;top:-14% !important;}
  .panel[data-z="180"]{right:-44% !important;top:32% !important;}
  .panel[data-z="90"] {left:-38% !important;top:76% !important;}
}
@media (max-width:380px){
  .panel{max-width:36vw;padding:7px 9px;}
  .panel .v{font-size:10.5px;}
  .panel[data-z="120"]{left:-40% !important;}
  .panel[data-z="180"]{right:-38% !important;}
  .panel[data-z="90"] {left:-34% !important;}
}

#vignette{position:fixed;inset:0;z-index:2;pointer-events:none;
  background:radial-gradient(ellipse at 50% 34%,transparent 30%,var(--vig) 100%);}

/* ══ LAPISAN 1b · FIGURA YAB & YB (penyeri, penjuru bawah-kanan) ══ */
#vip{
  position:fixed;right:8px;bottom:0;z-index:4;pointer-events:none;
  width:min(26vw,170px);aspect-ratio:880/1210;
  background:url("./yab-yb.png") right bottom/contain no-repeat;
  opacity:1;
  filter:drop-shadow(0 6px 18px rgba(0,0,0,.35));
  transition:opacity .5s cubic-bezier(.4,0,.2,1),transform .5s;
  animation:vipRise 1s .35s cubic-bezier(.2,.9,.3,1) both;
}
@keyframes vipRise{from{opacity:0;transform:translateY(34px)}}
[data-theme="light"] #vip{filter:drop-shadow(0 6px 18px rgba(120,95,40,.28));}
/* Beralih tepi bila pengguna menaip / semasa loader — tak menghalang kad */
body.focused #vip{opacity:.35;transform:translateY(14px)}
body.busy    #vip{opacity:0;transform:translateY(24px)}
@media (max-width:480px){ #vip{width:34vw;right:2px;} }
@media (prefers-reduced-motion:reduce){ #vip{animation:none} }

/* ══ LAPISAN 3 · SHELL BOLEH SKROL ══ */
#shell{
  position:relative;z-index:3;min-height:100vh;
  display:flex;flex-direction:column;align-items:center;
  padding:14px 16px calc(40px + env(safe-area-inset-bottom));
}

/* ── TOPBAR ── */
.topbar{
  width:100%;max-width:440px;display:flex;justify-content:space-between;align-items:center;
  margin-bottom:calc(24vh);position:relative;z-index:10;animation:fadeDown .4s ease both;
}
.lang-row{display:flex;gap:3px;background:var(--card);border:1px solid var(--border);border-radius:99px;padding:3px;backdrop-filter:blur(14px);box-shadow:0 2px 10px var(--shadow);}
.lb{border:none;background:transparent;color:var(--text3);font-family:'DM Sans',sans-serif;font-size:11px;font-weight:600;padding:5px 10px;border-radius:99px;cursor:pointer;transition:all var(--ease);}
.lb:hover{color:var(--text2);}
.lb.on{background:linear-gradient(180deg,var(--gold),var(--gold-lo));color:#1a1305;box-shadow:0 2px 10px rgba(217,180,92,.35);}
.theme-btn{width:38px;height:38px;border:1px solid var(--border);border-radius:50%;background:var(--card);cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:16px;transition:all var(--ease);backdrop-filter:blur(14px);box-shadow:0 2px 10px var(--shadow);}
.theme-btn:hover{border-color:var(--gold);transform:rotate(15deg);}

/* ── KAD SEMAKAN (kaca) ── */
.card{
  width:100%;max-width:440px;padding:22px 20px;border-radius:24px;
  background:linear-gradient(180deg,var(--card),var(--card2));
  border:1px solid var(--border);
  backdrop-filter:blur(20px) saturate(1.3);-webkit-backdrop-filter:blur(20px) saturate(1.3);
  box-shadow:0 -8px 60px var(--shadow),0 24px 70px var(--shadow),inset 0 1px 0 rgba(255,255,255,.08);
  will-change:transform;transition:transform .5s cubic-bezier(.2,.9,.3,1),background var(--ease),border-color var(--ease);
  animation:fadeUp .5s .05s ease both;
}
.grabber{width:38px;height:4px;border-radius:99px;background:var(--border2);margin:0 auto 16px;}
.eyebrow{font-size:10px;letter-spacing:.26em;text-transform:uppercase;color:var(--gold);display:block;}
h1{font-size:clamp(20px,5vw,24px);font-weight:300;letter-spacing:-.02em;margin:6px 0 16px;line-height:1.25;}
h1 em,h1 b{font-style:normal;font-weight:700;
  background:linear-gradient(100deg,var(--gold-lo),var(--gold-hi) 45%,var(--gold));
  -webkit-background-clip:text;background-clip:text;color:transparent;}

.flabel{display:block;font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--gold);margin-bottom:7px;}
input[type=text]{
  width:100%;padding:14px 16px;border-radius:13px;
  background:var(--surface);border:1px solid var(--border);
  color:var(--text);font-family:var(--mono);font-size:18px;letter-spacing:.09em;
  font-variant-numeric:tabular-nums;text-align:center;outline:none;
  transition:border-color .25s,box-shadow .25s,background var(--ease);
}
input::placeholder{color:var(--text3);opacity:.65;}
input:focus{border-color:var(--gold);box-shadow:0 0 0 4px rgba(217,180,92,.13);}
input.done{border-color:var(--green);box-shadow:0 0 0 4px rgba(92,232,164,.13);}
.count{margin-top:6px;font-size:10.5px;color:var(--text3);text-align:right;font-variant-numeric:tabular-nums;}
.err{color:var(--red);font-size:12px;margin-top:4px;min-height:15px;}

/* ── KOTAK GONCANG ── */
#shakeBox{
  margin-top:12px;border-radius:15px;text-align:center;
  border:1px dashed var(--border2);background:rgba(217,180,92,.07);
  max-height:0;opacity:0;overflow:hidden;padding:0 14px;border-width:0;
  transition:max-height .45s cubic-bezier(.2,.8,.3,1),opacity .3s,padding .35s,border-width .2s;
}
#shakeBox.show{max-height:260px;opacity:1;padding:16px 14px;border-width:1px;}
.phone{width:31px;height:51px;margin:0 auto 9px;border-radius:8px;border:2px solid var(--gold);position:relative;animation:wiggle 1.1s ease-in-out infinite;}
.phone::after{content:"";position:absolute;left:50%;bottom:5px;translate:-50% 0;width:11px;height:2px;background:var(--gold);border-radius:2px;}
@keyframes wiggle{0%,100%{transform:rotate(-13deg)}50%{transform:rotate(13deg)}}
.shakeMsg{font-size:14.5px;font-weight:600;color:var(--gold);}
.shakeSub{font-size:11.5px;color:var(--text3);margin-top:4px;}
.tick{width:36px;height:36px;margin:0 auto 8px;border-radius:50%;border:2px solid var(--green);color:var(--green);display:grid;place-items:center;font-size:19px;animation:pop .45s cubic-bezier(.2,1.4,.4,1);}
.note{margin-top:11px;font-size:11px;line-height:1.55;color:var(--text3);opacity:.8;}
.note b{color:var(--gold);font-weight:600;}

/* ── BUTANG ── */
.btn{
  width:100%;margin-top:12px;padding:15px;border-radius:13px;border:1px solid var(--border);
  background:linear-gradient(180deg,rgba(217,180,92,.24),rgba(217,180,92,.10));
  color:var(--gold);font-family:'DM Sans',sans-serif;font-size:15px;font-weight:700;cursor:pointer;
  transition:transform .12s,opacity .2s;
}
.btn:active{transform:scale(.98)}
.btn:disabled{opacity:.32;cursor:not-allowed}
.btn.ghost{background:transparent;color:var(--text3);font-weight:400;font-size:12.5px;padding:10px;}

/* ══ LOADER MENARA ══ */
#loader{
  position:fixed;inset:0;z-index:250;display:none;
  background:color-mix(in srgb,var(--bg) 93%,transparent);
  backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
  flex-direction:column;align-items:center;justify-content:center;gap:20px;
}
#loader.show{display:flex;animation:fade .35s}
@keyframes fade{from{opacity:0}}
.tower{display:flex;flex-direction:column-reverse;gap:5px;width:108px;}
.floor{height:14px;border-radius:3px;border:1px solid var(--border);background:rgba(217,180,92,.04);
  position:relative;overflow:hidden;opacity:.25;transform:translateY(9px) scaleX(.82);
  transition:opacity .3s,transform .45s cubic-bezier(.2,1.5,.4,1);}
.floor.built{opacity:1;transform:none;
  background:linear-gradient(90deg,rgba(217,180,92,.30),rgba(217,180,92,.14));
  border-color:var(--border2);box-shadow:0 0 14px rgba(217,180,92,.28);}
.floor.built::after{content:"";position:absolute;inset:3px 5px;
  background:repeating-linear-gradient(90deg,var(--gold) 0 3px,transparent 3px 11px);opacity:.5;}
.roof{width:0;height:0;margin:0 auto 5px;border-left:25px solid transparent;border-right:25px solid transparent;
  border-bottom:17px solid var(--gold);opacity:0;transform:translateY(12px);
  transition:opacity .4s,transform .5s cubic-bezier(.2,1.6,.4,1);}
.roof.built{opacity:1;transform:none}
.pct{font-size:30px;font-weight:700;font-variant-numeric:tabular-nums;
  background:linear-gradient(100deg,var(--gold-lo),var(--gold-hi) 50%,var(--gold));
  -webkit-background-clip:text;background-clip:text;color:transparent;}
.stage-txt{font-size:12px;color:var(--text3);letter-spacing:.04em;min-height:17px;text-align:center;padding:0 24px;}

/* ══ KEPUTUSAN (susunan kekal seperti asal) ══ */
#result{margin-top:20px;display:none;}
#result.show{display:block;animation:pop .45s cubic-bezier(.2,1.4,.4,1);}
@keyframes pop{from{opacity:0;transform:translateY(12px) scale(.98)}}

.res-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;flex-wrap:wrap;gap:10px;}
.sheet-badge{display:inline-flex;align-items:center;gap:5px;padding:5px 14px;border-radius:99px;font-size:11px;font-weight:800;letter-spacing:.08em;}
.sheet-badge.BSR{background:var(--bsr-d);color:var(--bsr-h);border:1px solid var(--bsr-b);}
.sheet-badge.BMR{background:var(--bmr-d);color:var(--bmr-h);border:1px solid var(--bmr-b);}
.sheet-badge.BBR{background:var(--bbr-d);color:var(--bbr-h);border:1px solid var(--bbr-b);}
.found-tag{display:flex;align-items:center;gap:6px;font-size:13px;font-weight:700;}
.found-tag.ok{color:var(--green);} .found-tag.err{color:var(--red);}

.res-nama{font-size:20px;font-weight:800;color:var(--text);letter-spacing:-.03em;margin-bottom:6px;}
.res-ic{font-family:var(--mono);font-size:13.5px;color:var(--text);font-weight:600;letter-spacing:.08em;
  background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:6px 12px;display:inline-block;margin-bottom:16px;}

.result-summary{display:flex;align-items:center;justify-content:space-between;background:var(--surface);
  border:1px solid var(--border);border-radius:12px;padding:11px 16px;margin-bottom:16px;font-size:12.5px;flex-wrap:wrap;gap:8px;}
.rs-count{font-weight:700;color:var(--text);} .rs-count span{color:var(--gold);}
.rs-sheets{display:flex;gap:6px;}
.rs-sheet-tag{font-size:10px;font-weight:700;letter-spacing:.06em;padding:2px 8px;border-radius:99px;}
.rs-sheet-tag.BSR{background:var(--bsr-d);color:var(--bsr-h);}
.rs-sheet-tag.BMR{background:var(--bmr-d);color:var(--bmr-h);}
.rs-sheet-tag.BBR{background:var(--bbr-d);color:var(--bbr-h);}

/* ── KUMPULAN SHEET ── */
.sheet-group{margin-bottom:16px;border-radius:18px;overflow:hidden;border:1px solid var(--border);}
.sheet-group-header{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:10px 14px;
  font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;flex-wrap:wrap;}
.sheet-group.BSR .sheet-group-header{background:var(--bsr-d);color:var(--bsr-h);border-bottom:1px solid var(--bsr-b);}
.sheet-group.BMR .sheet-group-header{background:var(--bmr-d);color:var(--bmr-h);border-bottom:1px solid var(--bmr-b);}
.sheet-group.BBR .sheet-group-header{background:var(--bbr-d);color:var(--bbr-h);border-bottom:1px solid var(--bbr-b);}
.sheet-group-body{padding:14px;display:grid;gap:10px;}

.match-card{background:var(--surface);border-radius:12px;border:1px solid var(--border);
  transition:all var(--ease);position:relative;overflow:hidden;display:flex;flex-direction:column;}
.mc-main{display:flex;align-items:flex-start;gap:12px;padding:14px 14px 14px 18px;}
.match-card::before{content:'';position:absolute;left:0;top:0;bottom:0;width:4px;}
.sheet-group.BSR .match-card::before{background:var(--bsr-h);}
.sheet-group.BMR .match-card::before{background:var(--bmr-h);}
.sheet-group.BBR .match-card::before{background:var(--bbr-h);}
.mc-kaunter{text-align:center;flex-shrink:0;width:64px;}
.mc-k-lbl{font-size:8px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;margin-bottom:5px;}
.sheet-group.BSR .mc-k-lbl{color:var(--bsr-h);}
.sheet-group.BMR .mc-k-lbl{color:var(--bmr-h);}
.sheet-group.BBR .mc-k-lbl{color:var(--bbr-h);}
.mc-k-num{font-family:var(--mono);font-size:34px;font-weight:700;line-height:1;
  display:inline-flex;align-items:center;justify-content:center;min-width:54px;padding:6px 10px;border-radius:12px;}
.sheet-group.BSR .mc-k-num{color:var(--bsr-h);background:var(--bsr-d);border:1.5px solid var(--bsr-b);text-shadow:0 0 18px var(--bsr-b);}
